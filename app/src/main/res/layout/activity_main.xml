
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:orientation="vertical">

    <EditText
        android:id="@+id/edtTenKhoanChi_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên khoản chi"
        android:inputType="text" />

    <EditText
        android:id="@+id/edtSoTien_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số tiền"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/edtGhiChu_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ghi chú"
        android:inputType="textMultiLine" />

    <Button
        android:id="@+id/btnThem_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm khoản chi" />

    <Button
        android:id="@+id/btnChiTiet_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem chi tiết khoản chi" />

</LinearLayout>
